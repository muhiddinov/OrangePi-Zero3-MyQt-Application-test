 .../etc/init.d/S03rootfs-expand               | 67 +++++++++++++++++
 configs/orangepi_zero3_defconfig              | 73 ++++++++++++++++++-
 local.mk                                      |  7 ++
 7 files changed, 155 insertions(+), 6 deletions(-)
 create mode 100644 board/orangepi/orangepi-zero3/linux-extras.config
 create mode 100755 board/orangepi/orangepi-zero3/rootfs-overlay/etc/init.d/S03rootfs-expand
