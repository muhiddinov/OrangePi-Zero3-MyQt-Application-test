diff --git a/board/orangepi/orangepi-zero3/rootfs-overlay/etc/init.d/S03rootfs-expand b/board/orangepi/orangepi-zero3/rootfs-overlay/etc/init.d/S03rootfs-expand
new file mode 100755
index 00000000000..d63be0a58f5
--- /dev/null
+++ b/board/orangepi/orangepi-zero3/rootfs-overlay/etc/init.d/S03rootfs-expand
@@ -0,0 +1,67 @@
+#!/bin/sh
+#
+# Grow the root partition (GPT) and its ext4 filesystem to fill the whole
+# SD card, the same idea as raspi-config's "expand filesystem". Safe to
+# run every boot: it compares actual sizes and only acts (and reboots)
+# when there is real slack to claim, so once fully expanded it is a
+# fast no-op.
+
+[ "$1" != "start" ] && exit 0
+
+# /proc/mounts often just shows "/dev/root" as the source, which isn't a
+# real device node. Resolve the actual device via the kernel's own
+# major:minor for "/" (from mountinfo) through /sys/dev/block instead.
+ROOT_MAJMIN=$(awk '$5 == "/" {print $3; exit}' /proc/self/mountinfo)
+ROOT_DEV="/dev/$(basename "$(readlink -f "/sys/dev/block/$ROOT_MAJMIN")")"
+
+case "$ROOT_DEV" in
+	*mmcblk*p[0-9]*)
+		DISK=${ROOT_DEV%p*}
+		PARTNUM=${ROOT_DEV##*p}
+		;;
+	/dev/*[0-9])
+		PARTNUM=$(echo "$ROOT_DEV" | grep -oE '[0-9]+$')
+		DISK=${ROOT_DEV%$PARTNUM}
+		;;
+	*)
+		echo "rootfs-expand: can't parse root device '$ROOT_DEV', skipping"
+		exit 0
+		;;
+esac
+
+DISK_SECTORS=$(blockdev --getsz "$DISK" 2>/dev/null)
+PART_END=$(parted -s -m "$DISK" unit s print 2>/dev/null | \
+	awk -F: -v n="$PARTNUM" '$1==n {gsub("s","",$3); print $3}')
+
+if [ -z "$DISK_SECTORS" ] || [ -z "$PART_END" ]; then
+	echo "rootfs-expand: could not read disk/partition sizes, skipping"
+	exit 0
+fi
+
+# More than ~1MiB of unclaimed space after the root partition: grow the
+# partition table entry, then reboot so the kernel re-reads it cleanly.
+if [ $((DISK_SECTORS - PART_END)) -gt 2048 ]; then
+	echo "rootfs-expand: growing partition $PARTNUM on $DISK to fill the disk"
+	parted -s -f "$DISK" resizepart "$PARTNUM" 100%
+	sync
+	reboot
+	exit 0
+fi
+
+FS_BLOCKS=$(dumpe2fs -h "$ROOT_DEV" 2>/dev/null | awk -F: '/Block count/ {gsub(/ /,"",$2); print $2}')
+BLOCK_SIZE=$(dumpe2fs -h "$ROOT_DEV" 2>/dev/null | awk -F: '/Block size/ {gsub(/ /,"",$2); print $2}')
+
+if [ -z "$FS_BLOCKS" ] || [ -z "$BLOCK_SIZE" ]; then
+	echo "rootfs-expand: could not read filesystem size, skipping"
+	exit 0
+fi
+
+PART_BYTES=$(( (PART_END + 1) * 512 ))
+FS_BYTES=$(( FS_BLOCKS * BLOCK_SIZE ))
+
+# More than ~10MiB of the (now full-size) partition still unused by the
+# filesystem: grow the filesystem to match.
+if [ $((PART_BYTES - FS_BYTES)) -gt 10485760 ]; then
+	echo "rootfs-expand: growing filesystem on $ROOT_DEV"
+	resize2fs "$ROOT_DEV"
+fi
diff --git a/configs/orangepi_zero3_defconfig b/configs/orangepi_zero3_defconfig
index c6aa9c991a6..7cb96021cc7 100644
--- a/configs/orangepi_zero3_defconfig
+++ b/configs/orangepi_zero3_defconfig
@@ -1,6 +1,7 @@
 BR2_aarch64=y
 BR2_ARM_FPU_VFPV4=y
-BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
+BR2_TOOLCHAIN_BUILDROOT_CXX=y
+BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y
 BR2_GLOBAL_PATCH_DIR="board/orangepi/orangepi-zero3/patches"
 BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
 BR2_TARGET_GENERIC_ISSUE="Welcome to Orangepi Zero3"
@@ -9,10 +10,13 @@ BR2_SYSTEM_DHCP="eth0"
 BR2_ROOTFS_POST_BUILD_SCRIPT="board/orangepi/common/post-build.sh"
 BR2_ROOTFS_POST_IMAGE_SCRIPT="support/scripts/genimage.sh"
 BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(BINARIES_DIR)/genimage.cfg"
+BR2_ROOTFS_OVERLAY="board/orangepi/orangepi-zero3/rootfs-overlay"
 BR2_LINUX_KERNEL=y
 BR2_LINUX_KERNEL_CUSTOM_VERSION=y
-BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.6"
-BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
+BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.1.31"
+BR2_LINUX_KERNEL_USE_DEFCONFIG=y
+BR2_LINUX_KERNEL_DEFCONFIG="linux_sunxi64"
+BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/orangepi/orangepi-zero3/linux-extras.config"
 BR2_LINUX_KERNEL_DTS_SUPPORT=y
 BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-h618-orangepi-zero3"
 BR2_LINUX_KERNEL_DTB_KEEP_DIRNAME=y
@@ -20,7 +24,7 @@ BR2_LINUX_KERNEL_INSTALL_TARGET=y
 BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
 BR2_TARGET_ROOTFS_EXT2=y
 BR2_TARGET_ROOTFS_EXT2_4=y
-BR2_TARGET_ROOTFS_EXT2_SIZE="130M"
+BR2_TARGET_ROOTFS_EXT2_SIZE="700M"
 # BR2_TARGET_ROOTFS_TAR is not set
 BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
 BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION=y
@@ -41,3 +45,64 @@ BR2_TARGET_UBOOT_SPL_NAME="u-boot-sunxi-with-spl.bin"
 BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="SCP=/dev/null"
 BR2_PACKAGE_HOST_GENIMAGE=y
 BR2_PACKAGE_HOST_UBOOT_TOOLS=y
+
+# GPU acceleration (Panfrost): probing used to hang because the H616 PRCM
+# power-domain driver/DT node were missing. Backported from mainline v6.17
+# (drivers/soc/sunxi/sun50i-h6-prcm-ppu.c + power-domains on the gpu node).
+# llvmpipe stays as a software-rendering fallback.
+BR2_PACKAGE_MESA3D=y
+BR2_PACKAGE_MESA3D_LLVM=y
+BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
+BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
+BR2_PACKAGE_MESA3D_OPENGL_EGL=y
+BR2_PACKAGE_MESA3D_OPENGL_ES=y
+
+# Qt5 / QML. The EGLFS+DRM/KMS+EGL/GBM stack hangs indefinitely on this
+# board somewhere between GBM surface creation and the first GL context
+# (reproduced with real Panfrost, with LIBGL_ALWAYS_SOFTWARE=1, and with
+# MESA_LOADER_DRIVER_OVERRIDE=swrast - so it's not specific to any one
+# rendering backend). linuxfb + Qt Quick's "software" backend draws via
+# QPainter straight to /dev/fb0, bypassing EGL/DRM/GBM/Mesa entirely.
+BR2_PACKAGE_QT5=y
+BR2_PACKAGE_QT5BASE=y
+BR2_PACKAGE_QT5BASE_GUI=y
+BR2_PACKAGE_QT5BASE_PNG=y
+BR2_PACKAGE_QT5BASE_OPENGL_ES2=y
+BR2_PACKAGE_QT5BASE_EGLFS=y
+BR2_PACKAGE_QT5BASE_LINUXFB=y
+BR2_PACKAGE_QT5BASE_DEFAULT_QPA="linuxfb"
+BR2_PACKAGE_QT5DECLARATIVE=y
+BR2_PACKAGE_QT5DECLARATIVE_QUICK=y
+BR2_PACKAGE_QT5QUICKCONTROLS2=y
+BR2_PACKAGE_QT5MULTIMEDIA=y
+BR2_PACKAGE_QT5VIRTUALKEYBOARD=y
+BR2_PACKAGE_QT5SERIALPORT=y
+
+# Fonts - Qt had NO fonts at all (QFontDatabase repeatedly failed to find
+# /usr/lib/fonts, likely contributing to slow startup + the segfault we saw
+# once glyph rendering was actually reached).
+BR2_PACKAGE_DEJAVU=y
+
+# GStreamer backend for Qt5Multimedia (video playback). Software H.264/MP4
+# decode via gst1-libav (ffmpeg) - no hardware cedrus decode yet, that
+# needs udev (we use mdev) for the v4l2codecs stateless plugin.
+BR2_PACKAGE_GSTREAMER1=y
+BR2_PACKAGE_GST1_PLUGINS_BASE=y
+BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA=y
+BR2_PACKAGE_GST1_PLUGINS_GOOD=y
+BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ISOMP4=y
+BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUTODETECT=y
+BR2_PACKAGE_GST1_LIBAV=y
+
+# Custom C++/Qt application (br2-external/package/myqtapp)
+BR2_PACKAGE_MYQTAPP=y
+
+# SSH access (root/orangepi)
+BR2_TARGET_GENERIC_ROOT_PASSWD="orangepi"
+BR2_PACKAGE_OPENSSH=y
+
+# Auto-expand rootfs to fill the SD card on first boot (raspi-config style),
+# via board/orangepi/orangepi-zero3/rootfs-overlay/etc/init.d/S03rootfs-expand
+BR2_PACKAGE_PARTED=y
+BR2_PACKAGE_E2FSPROGS=y
+BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
diff --git a/local.mk b/local.mk
new file mode 100644
index 00000000000..e2438679569
--- /dev/null
+++ b/local.mk
@@ -0,0 +1,7 @@
+# Package source overrides: use the repos already cloned next to buildroot/
+# instead of re-downloading them, to avoid extra network/mobile-data usage.
+# Paths are relative to this file's own directory (buildroot/), so this
+# works regardless of where the top-level project is checked out.
+LINUX_OVERRIDE_SRCDIR = $(CURDIR)/../linux-orangepi
+UBOOT_OVERRIDE_SRCDIR = $(CURDIR)/../u-boot
+ARM_TRUSTED_FIRMWARE_OVERRIDE_SRCDIR = $(CURDIR)/../arm-trusted-firmware
-- 
