diff --git a/board/orangepi/orangepi-zero3/gen-kernel-logo.py b/board/orangepi/orangepi-zero3/gen-kernel-logo.py
new file mode 100755
index 00000000000..644c3226b0c
--- /dev/null
+++ b/board/orangepi/orangepi-zero3/gen-kernel-logo.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Regenerate the kernel boot logo (drivers/video/logo/logo_linux_clut224.ppm)
+from the same PNG myqtapp embeds for its own splash screen, so the two never
+drift out of sync.
+
+Usage: gen-kernel-logo.py <source.png> <output.ppm>
+
+Requires Pillow (pip install Pillow / python3-pillow) on the build host.
+
+The kernel's fbcon boot logo is not a fullscreen splash: it always shares
+the screen with at least a few rows of console text below it, and disables
+itself outright if the logo is too tall to leave any room ("boot-logo
+bigger than screen", see drivers/video/fbdev/core/fbcon.c). 1000px leaves
+enough of a margin on a 1080-tall display; see README.md for the details
+on fbcon=logo-pos:center,logo-count:1 needed to show it centered as a
+single copy instead of one small copy per CPU core.
+"""
+import sys
+
+from PIL import Image
+
+CANVAS_W, CANVAS_H = 1536, 800
+LOGO_WIDTH_FRACTION = 0.6
+MAX_COLORS = 224
+
+
+def main() -> int:
+    if len(sys.argv) != 3:
+        print(f"usage: {sys.argv[0]} <source.png> <output.ppm>", file=sys.stderr)
+        return 1
+    src_path, out_path = sys.argv[1], sys.argv[2]
+
+    logo = Image.open(src_path).convert("RGBA")
+
+    canvas = Image.new("RGBA", (CANVAS_W, CANVAS_H), (0, 0, 0, 255))
+    target_w = int(CANVAS_W * LOGO_WIDTH_FRACTION)
+    scale = target_w / logo.width
+    target_h = int(logo.height * scale)
+    logo_resized = logo.resize((target_w, target_h), Image.LANCZOS)
+    pos = ((CANVAS_W - target_w) // 2, (CANVAS_H - target_h) // 2)
+    canvas.alpha_composite(logo_resized, pos)
+
+    quantized = canvas.convert("RGB").quantize(colors=MAX_COLORS, method=Image.MEDIANCUT).convert("RGB")
+
+    w, h = quantized.size
+    pixels = list(quantized.getdata())
+    with open(out_path, "w") as f:
+        f.write("P3\n")
+        f.write(f"# Generated by {sys.argv[0]} from {src_path} - do not edit directly\n")
+        f.write(f"{w} {h}\n")
+        f.write("255\n")
+        for i, (r, g, b) in enumerate(pixels):
+            f.write(f"{r} {g} {b} ")
+            if (i + 1) % w == 0:
+                f.write("\n")
+
+    colors_used = len(quantized.getcolors(maxcolors=1_000_000))
+    print(f"wrote {out_path}: {w}x{h}, {colors_used} colors")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
